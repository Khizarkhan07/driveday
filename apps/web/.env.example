# Copy to .env.local (Vite convention) and fill in. Never commit the real file.

VITE_API_BASE_URL=http://localhost:4000

# Which market this build serves: uk or ie. Required, with no default — a
# missing or misspelled value must fail the build rather than silently ship
# the other market's currency, vehicle register and plate format.
VITE_MARKET=uk

# Stripe TEST MODE publishable key only (pk_test_...) — never a live key in this demo
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
